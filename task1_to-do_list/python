import tkinter as tk
from tkinter import messagebox
from tkinter import font as tkfont

BG = "#05000a"
PANEL = "#0b0014"
CYAN = "#00f6ff"
PINK = "#ff00aa"
GREEN = "#39ff14"
WHITE = "#e8ffff"
GRAY = "#8a8a9b"

tasks = []

root = tk.Tk()
root.title("NEON TASK // CYBERPUNK")
root.geometry("900x650")
root.configure(bg=BG)
root.resizable(False, False)

title_font = tkfont.Font(family="Consolas", size=26, weight="bold")
head_font = tkfont.Font(family="Consolas", size=13, weight="bold")
body_font = tkfont.Font(family="Consolas", size=11)

header = tk.Frame(root, bg=BG)
header.pack(fill="x", padx=35, pady=(25, 10))

tk.Label(
    header,
    text="◈ NEON TASK // TO-DO SYSTEM ◈",
    font=title_font,
    fg=CYAN,
    bg=BG
).pack()

tk.Label(
    header,
    text=">> TASK MANAGEMENT TERMINAL :: ONLINE",
    font=head_font,
    fg=PINK,
    bg=BG
).pack(pady=5)

input_frame = tk.Frame(root, bg=PANEL, highlightbackground=CYAN, highlightthickness=1)
input_frame.pack(fill="x", padx=35, pady=15)

task_entry = tk.Entry(
    input_frame,
    font=body_font,
    bg="#08000f",
    fg=WHITE,
    insertbackground=CYAN,
    relief="flat"
)
task_entry.pack(side="left", fill="x", expand=True, padx=15, pady=15)

def add_task():
    task = task_entry.get().strip()
    if not task:
        messagebox.showwarning("SYSTEM", "ENTER A TASK FIRST.")
        return

    tasks.append({"text": task, "done": False})
    task_entry.delete(0, tk.END)
    refresh()

def toggle_task(index):
    tasks[index]["done"] = not tasks[index]["done"]
    refresh()

def delete_task(index):
    del tasks[index]
    refresh()

def clear_tasks():
    if tasks and messagebox.askyesno("SYSTEM", "CLEAR ALL TASKS?"):
        tasks.clear()
        refresh()

tk.Button(
    input_frame,
    text="ADD TASK",
    command=add_task,
    font=head_font,
    fg=BG,
    bg=CYAN,
    activeforeground=BG,
    activebackground=WHITE,
    relief="flat",
    padx=18,
    pady=8,
    cursor="hand2"
).pack(side="right", padx=10)

list_frame = tk.Frame(root, bg=PANEL, highlightbackground=PINK, highlightthickness=1)
list_frame.pack(fill="both", expand=True, padx=35, pady=5)

canvas = tk.Canvas(list_frame, bg=PANEL, highlightthickness=0)
scrollbar = tk.Scrollbar(list_frame, command=canvas.yview)
task_container = tk.Frame(canvas, bg=PANEL)

task_container.bind(
    "<Configure>",
    lambda e: canvas.configure(scrollregion=canvas.bbox("all"))
)

canvas.create_window((0, 0), window=task_container, anchor="nw", width=815)
canvas.configure(yscrollcommand=scrollbar.set)

canvas.pack(side="left", fill="both", expand=True)
scrollbar.pack(side="right", fill="y")

def refresh():
    for widget in task_container.winfo_children():
        widget.destroy()

    for i, task in enumerate(tasks):
        row = tk.Frame(task_container, bg="#10001c")
        row.pack(fill="x", padx=10, pady=5)

        text = f"[✓] {task['text']}" if task["done"] else f"[ ] {task['text']}"
        color = GREEN if task["done"] else WHITE

        tk.Button(
            row,
            text=text,
            command=lambda i=i: toggle_task(i),
            anchor="w",
            font=body_font,
            fg=color,
            bg="#10001c",
            activeforeground=CYAN,
            activebackground="#180025",
            relief="flat",
            cursor="hand2"
        ).pack(side="left", fill="x", expand=True, padx=10, pady=8)

        tk.Button(
            row,
            text="DELETE",
            command=lambda i=i: delete_task(i),
            font=("Consolas", 9, "bold"),
            fg=PINK,
            bg="#10001c",
            activeforeground=WHITE,
            activebackground="#25001f",
            relief="flat",
            cursor="hand2"
        ).pack(side="right", padx=10)

    status.config(text=f">> TOTAL TASKS: {len(tasks)}  //  COMPLETED: {sum(t['done'] for t in tasks)}")

footer = tk.Frame(root, bg=BG)
footer.pack(fill="x", padx=35, pady=12)

status = tk.Label(
    footer,
    text=">> TOTAL TASKS: 0  //  COMPLETED: 0",
    font=head_font,
    fg=GREEN,
    bg=BG
)
status.pack(side="left")

tk.Button(
    footer,
    text="CLEAR ALL",
    command=clear_tasks,
    font=head_font,
    fg=BG,
    bg=PINK,
    activeforeground=BG,
    activebackground=WHITE,
    relief="flat",
    padx=15,
    cursor="hand2"
).pack(side="right")

root.bind("<Return>", lambda event: add_task())

task_entry.focus()
root.mainloop()